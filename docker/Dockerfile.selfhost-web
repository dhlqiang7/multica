# 运行时镜像：宿主机 pnpm build --standalone 产物。
# 结构对齐仓库根 Dockerfile.web 的 runtime stage。
# 由 docker/assemble-prebuilt-context.sh 拷入 prebuilt-context/ 后使用。
FROM node:22-alpine

WORKDIR /app

# Alpine openssl 安全修复（与 Dockerfile.web 保持同一 floor pin）。
RUN apk add --no-cache "libcrypto3>=3.5.8-r0" "libssl3>=3.5.8-r0"

ENV NODE_ENV=production
ENV REMOTE_API_URL=http://backend:8080

RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

# standalone 目录内含 apps/web/server.js 与 traced node_modules
COPY --chown=nextjs:nodejs web/standalone ./
COPY --chown=nextjs:nodejs web/static ./apps/web/.next/static
COPY --chown=nextjs:nodejs web/public ./apps/web/public
COPY --chown=nextjs:nodejs LICENSE NOTICE ./

USER nextjs

EXPOSE 3000
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

CMD ["node", "apps/web/server.js"]
